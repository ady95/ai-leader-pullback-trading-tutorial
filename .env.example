# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 절대 커밋하지 않습니다.

# 키움 REST API (https://openapi2.kiwoom.com)
# 모의투자 앱키로 시작합니다. 실전 앱키는 17장 승인 기준을 통과한 뒤에만 사용합니다.
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=

# paper | real  (기본 paper)
TRADING_MODE=paper

# Open DART (10장)
DART_API_KEY=

# KRX Open API (선택)
KRX_API_KEY=

# OpenAI 호환 LLM API (10장)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
